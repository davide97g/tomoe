{
  "title": "Tomoe Source Manifest",
  "description": "What a host app exposes to Tomoe: read-only sources, typed fields with roles and sensitivity, navigate-only actions.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 1000
        },
        "locale": {
          "default": "en",
          "type": "string",
          "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8})*$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "sources": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 500
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "rest"
                  },
                  "method": {
                    "type": "string",
                    "const": "GET"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/(?!\\/)\\S{0,299}$"
                  },
                  "pagination": {
                    "default": "none",
                    "type": "string",
                    "enum": [
                      "none",
                      "page",
                      "cursor",
                      "offset"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "method",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "graphql"
                  },
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "required": [
                  "kind",
                  "query"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "sql"
                  },
                  "table": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]{0,127}$"
                  }
                },
                "required": [
                  "kind",
                  "table"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "mcp"
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "tool"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "memory"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
          },
          "time": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
          },
          "fields": {
            "minItems": 1,
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "date",
                    "datetime",
                    "enum"
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "id",
                    "dimension",
                    "measure",
                    "time",
                    "text",
                    "reference"
                  ]
                },
                "values": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "unit": {
                  "type": "string",
                  "maxLength": 20
                },
                "sensitive": {
                  "default": false,
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "name",
                "label",
                "type",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "relations": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                }
              },
              "required": [
                "field",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "maxRows": {
            "default": 5000,
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          }
        },
        "required": [
          "id",
          "label",
          "origin",
          "key",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "const": "navigate"
          },
          "target": {
            "type": "string",
            "pattern": "^\\/(?!\\/)\\S{0,299}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "refresh": {
      "default": {
        "kind": "poll",
        "seconds": 60
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "poll"
            },
            "seconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 86400
            }
          },
          "required": [
            "kind",
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sse"
            },
            "path": {
              "type": "string",
              "pattern": "^\\/(?!\\/)\\S{0,299}$"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "webhook"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "version",
    "app",
    "sources"
  ],
  "additionalProperties": false
}
