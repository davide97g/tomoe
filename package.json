{
  "name": "tomoe",
  "private": true,
  "type": "module",
  "description": "A chat that designs dashboards and widgets on top of any app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davide97g/tomoe.git"
  },
  "homepage": "https://github.com/davide97g/tomoe#readme",
  "bugs": "https://github.com/davide97g/tomoe/issues",
  "keywords": [
    "generative-ui",
    "dashboard",
    "widgets",
    "claude",
    "claude-code",
    "agent-skills",
    "mcp",
    "openapi",
    "llms-txt"
  ],
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tomoe/web dev",
    "build": "pnpm --filter @tomoe/web build",
    "start": "node apps/server/src/main.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "example": "node examples/shop/run.ts",
    "example:server": "node examples/shop/server.ts",
    "schema": "pnpm --filter @tomoe/core schema"
  }
}
